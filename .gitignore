*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Java / Maven
target/
.mvn/wrapper/maven-wrapper.jar

# IDE ve işletim sistemi
.idea/
*.iml
.DS_Store
Thumbs.db

# Gizli bilgi ve ortama özel dosyalar
.env
.env.*
*.pem
*.key
*.p12
*.pfx
.netrc
_netrc
.pgpass
pgpass.conf
