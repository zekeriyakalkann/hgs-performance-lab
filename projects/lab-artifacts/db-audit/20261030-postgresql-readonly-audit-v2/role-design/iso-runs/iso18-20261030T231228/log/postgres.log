2026-10-30 23:13:00.198 +03 [10172] 00000 user=hgs2_audit db=hgs2_perftest_db host=127.0.0.1 app=psql LOG:  statement: WITH me AS (
	    SELECT oid, rolsuper FROM pg_catalog.pg_roles WHERE rolname = 'hgs2_perftest'
	),
	privs(privilege_type) AS (
	    VALUES ('SELECT'), ('INSERT'), ('UPDATE'), ('DELETE'),
	           ('TRUNCATE'), ('REFERENCES'), ('TRIGGER')
	)
	SELECT c.relname,
	       p.privilege_type,
	       pg_catalog.has_table_privilege(me.oid, c.oid, p.privilege_type) AS perftest_has_privilege,
	       CASE WHEN p.privilege_type IN ('SELECT', 'INSERT', 'UPDATE', 'REFERENCES')
	            THEN pg_catalog.has_any_column_privilege(me.oid, c.oid, p.privilege_type)
	       END                                                             AS perftest_any_column,
	       (c.relowner = me.oid)                                           AS perftest_is_owner,
	       COALESCE(acl.direct_acl, false)                                 AS direct_acl,
	       COALESCE(acl.public_acl, false)                                 AS public_acl,
	       CASE WHEN NOT pg_catalog.has_table_privilege(me.oid, c.oid, p.privilege_type) THEN '-'
	            WHEN me.rolsuper                      THEN 'superuser'
	            WHEN c.relowner = me.oid              THEN 'sahiplik'
	            WHEN COALESCE(acl.direct_acl, false)  THEN 'dogrudan ACL'
	            WHEN COALESCE(acl.public_acl, false)  THEN 'PUBLIC'
	            ELSE 'dolayli (rol uyeligi)'
	       END                                                             AS privilege_source
	FROM pg_catalog.pg_class c
	CROSS JOIN me
	CROSS JOIN privs p
	CROSS JOIN LATERAL (
	    SELECT bool_or(x.grantee = me.oid) AS direct_acl,
	           bool_or(x.grantee = 0)      AS public_acl
	    FROM pg_catalog.aclexplode(COALESCE(c.relacl, pg_catalog.acldefault('r', c.relowner))) AS x
	    WHERE x.privilege_type = p.privilege_type
	) AS acl
	WHERE c.relnamespace = pg_catalog.to_regnamespace('public')
	  AND c.relname IN ('admins', 'devices', 'logs', 'users')
	  AND c.relkind IN ('r', 'p')
	ORDER BY c.relname, p.privilege_type;
