__pycache__/
*.egg-info/
.venv/
.pytest_cache/
results/*
!results/.gitkeep
.env

# Python derleme ve paketleme çıktıları
*.py[cod]
build/
dist/

# Ortama özel değişken dosyaları (.env yukarıda)
.env.*

# Yerel yapılandırma ve senaryolar: gerçek hedef adresi, token veya parola içerebilir.
# configs/ altındaki (alt dizinler dahil) tüm JSON dosyaları dışarıda kalır; yalnızca
# açıkça adlandırılmış örnekler (*.example.json) izlenir. configs/ dizininin kendisi
# hariç tutulmadığı için bu istisna çalışır.
configs/**/*.json
!configs/**/*.example.json

# Kimlik bilgisi dosyaları (ör. HTTPS istemci sertifikası ve anahtarı, .netrc)
*.pem
*.key
*.p12
*.pfx
.netrc
_netrc
